<Window x:Class="ODBSee.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Bug / Feedback" Width="520" Height="440" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="RbBug" Content="Bug" IsChecked="True" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbIdea" Content="Idea / Improvement"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Title" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,2"/>
        <TextBox x:Name="TxtTitle" Grid.Row="2" Padding="3" Margin="0,0,0,8" MaxLength="200"/>

        <TextBlock Grid.Row="3" Text="Description" FontSize="11" Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,2"/>
        <TextBox x:Name="TxtBody" Grid.Row="4" Padding="4" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>

        <TextBlock x:Name="TxtNote" Grid.Row="5" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.Warning}" Margin="0,8,0,0"
                   Text="GitHub issues are public. Only what you type plus the app and Windows version is sent, so leave out server, database and table names or any data."/>

        <DockPanel Grid.Row="6" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="TxtMode" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Subtle}"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="14,4" IsCancel="True"/>
            <Button x:Name="BtnSend" DockPanel.Dock="Right" Content="Send" Padding="18,4" Margin="0,0,8,0" Click="BtnSend_Click"/>
        </DockPanel>
    </Grid>
</Window>
